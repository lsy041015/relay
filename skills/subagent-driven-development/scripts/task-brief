#!/usr/bin/env bash
# Extract one task's full text from an implementation plan into a file the
# implementer reads in one call, so the task text never has to be pasted
# through the controller's context.
#
# Usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]
# Default OUTFILE: <repo-root>/.superpowers/sdd/<plan-basename>/task-<N>-brief.md
# (per plan and per worktree; concurrent runs of the SAME plan in the same
# working tree share it).
set -euo pipefail

if [ $# -lt 2 ] || [ $# -gt 3 ]; then
  echo "usage: task-brief PLAN_FILE TASK_NUMBER [OUTFILE]" >&2
  exit 2
fi

plan=$1
n=$2
[ -f "$plan" ] || { echo "no such plan file: $plan" >&2; exit 2; }

if [[ ! "$n" =~ ^[1-9][0-9]*$ ]]; then
  echo "invalid task number '$n': expected a positive integer" >&2
  exit 2
fi

if [ $# -eq 3 ]; then
  out=$3
else
  # Invoke via bash rather than direct exec: some extractors (Python zipfile)
  # strip Unix exec bits when unpacking marketplace packages (#2040).
  dir=$("${BASH:-bash}" "$(cd "$(dirname "$0")" && pwd)/sdd-workspace" "$plan")
  out="$dir/task-${n}-brief.md"
fi

# Replacing the plan itself would destroy the source before a later task can
# be extracted.  -ef also catches an absolute/relative alias or hard link.
if [ -e "$out" ] && [ "$plan" -ef "$out" ]; then
  echo "plan and output must be different files: $plan" >&2
  exit 2
fi
if [ -d "$out" ]; then
  echo "output must be a file, not a directory: $out" >&2
  exit 2
fi

out_dir=$(dirname -- "$out")
out_name=$(basename -- "$out")
tmp=$(mktemp "$out_dir/.${out_name}.tmp.XXXXXX")
err=$(mktemp "$out_dir/.${out_name}.err.XXXXXX")
cleanup() {
  [ -z "${tmp:-}" ] || rm -f -- "$tmp"
  [ -z "${err:-}" ] || rm -f -- "$err"
}
trap cleanup EXIT HUP INT TERM

if ! awk -v target="$n" -v error_file="$err" '
  function report(message) {
    if (!invalid) print message > error_file
    invalid = 1
  }

  # Compare decimal task numbers as strings so very large, valid numbers do
  # not lose precision in awk numeric coercion.
  function same_text(a, b, i) {
    if (length(a) != length(b)) return 0
    for (i = 1; i <= length(a); i++)
      if (substr(a, i, 1) != substr(b, i, 1)) return 0
    return 1
  }

  BEGIN {
    invalid = 0
    in_fence = 0
    intask = 0
    found = 0
  }

  {
    # Markdown permits at most three leading spaces before a fence or ATX
    # heading.  Deliberately do not consume tabs or a fourth space.
    indent = 0
    while (indent < 3 && substr($0, indent + 1, 1) == " ") indent++
    rest = substr($0, indent + 1)
    # Normalize CRLF for parsing only; print keeps the original line bytes.
    sub(/\r$/, "", rest)

    if (in_fence) {
      run = 0
      while (substr(rest, run + 1, 1) == fence_char) run++
      tail = substr(rest, run + 1)
      closed = (run >= fence_len && tail ~ /^[ \t]*$/)
      if (intask) print
      if (closed) in_fence = 0
      next
    }

    # A fence opens with at least three backticks or tildes.  The opening
    # fence may carry an info string; a closing fence may carry whitespace
    # only and must use the same character with at least the opening length.
    fence_char = substr(rest, 1, 1)
    run = 0
    while ((fence_char == "`" || fence_char == "~") &&
           substr(rest, run + 1, 1) == fence_char) run++
    if (run >= 3) {
      in_fence = 1
      fence_len = run
      if (intask) print
      next
    }

    # Parse ATX headings without a broad Markdown parser.  This keeps the
    # existing Task N interface while rejecting ambiguous numeric headings.
    hashes = 0
    while (substr(rest, hashes + 1, 1) == "#") hashes++
    heading_tail = substr(rest, hashes + 1)
    is_heading = (hashes > 0 && heading_tail ~ /^[ \t]+/)
    is_task = 0

    if (is_heading) {
      sub(/^[ \t]+/, "", heading_tail)
      if (heading_tail ~ /^Task([ \t]+[0-9]|[ \t]*$)/) {
        task_text = heading_tail
        sub(/^Task[ \t]*/, "", task_text)
        if (match(task_text, /^[0-9]+/)) {
          task_number = substr(task_text, RSTART, RLENGTH)
          if (task_number !~ /^[1-9][0-9]*$/) {
            report("invalid task heading: use ### Task N: title with a positive integer")
          } else {
            is_task = 1
            if (task_level == 0) task_level = hashes
            task_key = "n:" task_number
            if (seen[task_key])
              report("duplicate task number: " task_number)
            seen[task_key] = 1
          }
        } else {
          report("invalid task heading: use ### Task N: title with a positive integer")
        }
      } else if (heading_tail ~ /^[0-9]+([^0-9]|$)/) {
        # Before the first task, numeric headings are document context.
        # Only peers of an established task heading are ambiguous tasks;
        # parent sections and deeper body headings remain ordinary content.
        if (task_level > 0 && hashes == task_level)
          report("invalid task heading: use ### Task N: title instead of a numeric heading")
      }
    }

    if (is_task) {
      if (same_text(task_number, target)) {
        intask = 1
        found = 1
      } else if (intask) {
        intask = 0
      }
      if (intask) print
      next
    }

    if (intask) print
  }

  END {
    if (in_fence)
      report("unclosed code fence: cannot extract a complete task")
    if (!found)
      report("task " target " not found in plan (expected a heading such as ### Task " target ": title)")
    if (invalid) exit 1
  }
' < "$plan" > "$tmp"; then
  if [ -s "$err" ]; then
    cat "$err" >&2
  else
    echo "failed to parse plan: $plan" >&2
  fi
  exit 3
fi

# The temporary file lives beside the destination, so this rename is atomic
# on the destination filesystem and the old output remains intact on failure.
mv -f -- "$tmp" "$out"
tmp=
rm -f -- "$err"
err=
trap - EXIT HUP INT TERM

echo "wrote ${out}: $(wc -l < "$out" | tr -d ' ') lines"
